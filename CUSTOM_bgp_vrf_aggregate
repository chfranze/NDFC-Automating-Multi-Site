##template variables

@(DisplayName="BGP AS #", Description="BGP Autonomous System number")
string BGP_AS;

@(DisplayName="VRF Name", Description="Name of the VRF")
string VRF_NAME;

@(DisplayName="IP ggregate prefix to advertise", Description="IP prefix in CIDR format")
ipV4AddressWithSubnet IP_PREFIX;

